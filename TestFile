def get_bot_response(user_message, conversation):
    history = "\n\n".join(conversation)

    prompt = (
        f"Conversation history:\n{history}\n\n"
        f"Latest user message:\n{user_message}"
    )

    response = client.models.generate_content(
        model="gemini-3.1-flash-lite",
        contents=prompt,
        config={
            "system_instruction": f"{SYSTEM_INSTRUCTION}\n\n{resource_instruction}"
        }
    )

    return response.text


def contact_team():
    if not discord_webhook_url:
        print("Support contact is not configured yet.")
        return

    print(
        "Your message and any reply email will be sent to our Discord support "
        "channel. Staff will follow up manually. Do not include passwords, "
        "verification codes, recovery codes, or payment details."
    )
    print(
        "Tu mensaje y cualquier correo para responder se enviarán a nuestro "
        "canal de soporte de Discord. El equipo responderá manualmente. No "
        "incluyas contraseñas, códigos de verificación o recuperación, ni "
        "datos de pago."
    )
    name = input("Name / Nombre (optional / opcional): ").strip()
    reply_email = input("Reply email / Correo para responder (optional / opcional): ").strip()
    support_message = input("How can we help? / ¿Cómo podemos ayudarte?\n").strip()

    if not support_message:
        print("No message sent. / No se envió ningún mensaje.")
        return
    if len(name) > 100 or len(reply_email) > 254 or len(support_message) > 3500:
        print("One of the fields is too long; please try again with less text.")
        return

    confirmation = input("Send this request to our support team? [y/N]: ").strip()
    if confirmation.lower() not in {"y", "yes", "s", "sí", "si"}:
        print("No message sent. / No se envió ningún mensaje.")
        return

    payload = {
        "allowed_mentions": {"parse": []},
        "embeds": [
            {
                "title": "Customer support request",
                "description": support_message,
                "fields": [
                    {"name": "Name", "value": name or "Not provided"},
                    {
                        "name": "Reply email",
                        "value": reply_email or "Not provided",
                    },
                ],
            }
        ],
    }
    request = Request(
        discord_webhook_url,
        data=json.dumps(payload).encode("utf-8"),
        headers={
            "Content-Type": "application/json",
            "User-Agent": "DiscordBot (https://github.com, 1.0) JDXD_gemini",
        },
        method="POST",
    )

    try:
        with urlopen(request, timeout=10):
            pass
    except HTTPError as error:
        discord_message = None
        discord_code = None
        response_headers = error.headers or {}
        content_type = response_headers.get("Content-Type", "unknown")
        server = response_headers.get("Server", "unknown")
        raw_error_body = error.read(2048)
        fallback_detail = ""
        try:
            error_body = json.loads(raw_error_body.decode("utf-8"))
        except (UnicodeDecodeError, json.JSONDecodeError):
            error_body = {}
            response_text = raw_error_body.decode("utf-8", errors="replace").strip()
            for sensitive_value in (
                discord_webhook_url,
                api_key,
                name,
                reply_email,
                support_message,
            ):
                if sensitive_value:
                    response_text = response_text.replace(
                        sensitive_value, "[redacted]"
                    )
            if response_text:
                fallback_detail = f" Response body: {response_text[:300]}"
        if isinstance(error_body, dict):
            message = error_body.get("message")
            code = error_body.get("code")
            if isinstance(message, str):
                discord_message = message.replace(
                    discord_webhook_url, "[redacted webhook URL]"
                )[:200]
            if isinstance(code, int):
                discord_code = code
        detail = ""
        if discord_message:
            detail += f" Discord says: {discord_message}."
        if discord_code is not None:
            detail += f" Discord error code: {discord_code}."

        if error.code in {401, 404}:
            print(
                f"Discord rejected the webhook (HTTP {error.code}). "
                "Check that the webhook URL is complete and still active."
                f"{detail}"
            )
        elif error.code == 429:
            print("Discord is rate-limiting requests (HTTP 429). Please try again shortly.")
        else:
            print(
                f"Discord rejected the request (HTTP {error.code}). "
                "Check the webhook and channel access."
                f"{detail} Response content type: {content_type}; "
                f"response server: {server}.{fallback_detail}"
            )
        return
    except URLError as error:
        reason = error.reason
        print(
            "Could not connect to Discord "
            f"({type(reason).__name__}: {reason}). Check your internet connection."
        )
        return
    except TimeoutError:
        print("The request to Discord timed out. Please try again shortly.")
        return

    print(
        "Request sent. Our team can follow up using your email outside this "
        "chat. This webhook cannot deliver replies here."
    )
    print(
        "Solicitud enviada. El equipo puede responder por correo fuera de "
        "este chat. Este webhook no puede entregar respuestas aquí."
    )


def run_cli():
    conversation = []
    print("Digital Safety Helper / Asistente de seguridad digital")
    print("Technology should make life easier, not put you at risk.")
    print("La tecnología debería hacer la vida más fácil, no ponerte en riesgo.")
    print(
        "AI educational guidance only; not professional, emergency, or legal advice."
    )
    print(
        "Orientación educativa de IA; no es asesoramiento profesional, de emergencia ni legal."
    )
    print("Type 'contact' to reach our team / Escribe 'contact' para comunicarte con el equipo.")
    print("Type 'quit' to exit / Escribe 'quit' para salir.")

    while True:
        user_message = input("\nYou: ").strip()
        if user_message.lower() in {"quit", "exit"}:
            print("Stay safe online!")
            break
        if user_message.lower() in {"contact", "contact us", "support", "soporte", "contactar"}:
            contact_team()
            continue
        if not user_message:
            continue

        try:
            answer = get_bot_response(user_message, conversation)
            print(f"\nSafety Helper: {answer}")
            conversation.extend((f"User: {user_message}", f"Safety Helper: {answer}"))

        except Exception as error:
            print(f"\nGemini API error: {error}")
            print("Please check your API key and internet connection.")


def run_gui():
    import threading
    import tkinter as tk
    from tkinter.scrolledtext import ScrolledText
    from tkinter import ttk

    root = tk.Tk()
    root.title("Digital Safety Helper")
    root.geometry("680x560")
    root.minsize(420, 380)

    heading = ttk.Label(
        root,
        text="Digital Safety Helper / Asistente de seguridad digital",
        font=("Segoe UI", 15, "bold"),
        padding=(14, 14, 14, 6),
    )
    heading.pack(anchor="w")
    ttk.Label(
        root,
        text="AI educational guidance only; not professional, emergency, or legal advice.",
        wraplength=640,
        padding=(14, 0, 14, 10),
    ).pack(anchor="w")

    transcript = ScrolledText(root, wrap="word", state="disabled", padx=10, pady=10)
    transcript.pack(fill="both", expand=True, padx=14, pady=(0, 10))

    status = tk.StringVar(value="Ready")
    ttk.Label(root, textvariable=status, padding=(14, 0, 14, 6)).pack(anchor="w")

    controls = ttk.Frame(root, padding=(14, 0, 14, 14))
    controls.pack(fill="x")
    message_entry = ttk.Entry(controls)
    message_entry.pack(side="left", fill="x", expand=True, ipady=6)
    send_button = ttk.Button(controls, text="Send")
    send_button.pack(side="left", padx=(8, 0), ipady=3)

    conversation = []
    request_in_progress = False

    def append_message(speaker, message):
        transcript.configure(state="normal")
        transcript.insert("end", f"{speaker}: {message}\n\n")
        transcript.configure(state="disabled")
        transcript.see("end")

    def finish_request(user_message, answer):
        nonlocal request_in_progress
        request_in_progress = False
        send_button.configure(state="normal")
        if answer is None:
            status.set("Could not get a response. Check your connection and try again.")
            append_message("Helper", "Sorry, I couldn't respond just now. Please try again.")
        else:
            status.set("Ready")
            append_message("Safety Helper", answer)
            conversation.extend((f"User: {user_message}", f"Safety Helper: {answer}"))
        message_entry.focus_set()

    def send_message(event=None):
        nonlocal request_in_progress
        user_message = message_entry.get().strip()
        if not user_message or request_in_progress:
            return "break"
        if len(user_message) > 4000:
            status.set("Please keep messages under 4,000 characters.")
            return "break"

        request_in_progress = True
        send_button.configure(state="disabled")
        status.set("Thinking...")
        message_entry.delete(0, "end")
        append_message("You", user_message)
        history = list(conversation)

        def request_response():
            try:
                answer = get_bot_response(user_message, history)
            except Exception:
                answer = None
            root.after(0, finish_request, user_message, answer)

        threading.Thread(target=request_response, daemon=True).start()
        return "break" if event is not None else None

    send_button.configure(command=send_message)
    message_entry.bind("<Return>", send_message)
    append_message(
        "Helper",
        "I'm an AI digital safety helper. I provide general educational guidance, "
        "not professional, emergency, or legal advice.\n\n"
        "Soy un asistente de seguridad digital con IA. Ofrezco orientación "
        "educativa general, no asesoramiento profesional, de emergencia ni legal.",
    )
    message_entry.focus_set()
    root.mainloop()


class WebRequestHandler(SimpleHTTPRequestHandler):
    def __init__(self, *args, **kwargs):
        super().__init__(*args, directory=str(PROJECT_ROOT), **kwargs)

    def translate_path(self, path):
        resolved_path = Path(super().translate_path(path)).resolve()
        try:
            relative_path = resolved_path.relative_to(PROJECT_ROOT)
        except ValueError:
            return str(PROJECT_ROOT / "__not_found__")

        allowed_directories = {"About", "Contact", "Services", "homepage"}
        if not relative_path.parts or relative_path.parts[0] not in allowed_directories:
            return str(PROJECT_ROOT / "__not_found__")
        return str(resolved_path)

    def do_GET(self):
        if self.path == "/":
            self.send_response(302)
            self.send_header("Location", "/homepage/index.html")
            self.end_headers()
            return
        super().do_GET()

    def do_POST(self):
        if self.path != "/api/chat":
            self.send_json(404, {"error": "Endpoint not found."})
            return

        try:
            content_length = int(self.headers.get("Content-Length", "0"))
        except ValueError:
            self.send_json(400, {"error": "Invalid request."})
            return

        if content_length <= 0 or content_length > 100000:
            self.send_json(413, {"error": "Request must be under 100 KB."})
            return

        try:
            payload = json.loads(self.rfile.read(content_length))
        except (UnicodeDecodeError, json.JSONDecodeError):
            self.send_json(400, {"error": "Request must contain valid JSON."})
            return

        if not isinstance(payload, dict):
            self.send_json(400, {"error": "Invalid request."})
            return

        user_message = payload.get("message")
        conversation = payload.get("conversation", [])
        if (
            not isinstance(user_message, str)
            or not user_message.strip()
            or len(user_message) > 4000
            or not isinstance(conversation, list)
            or len(conversation) > 20
            or any(not isinstance(item, str) or len(item) > 4000 for item in conversation)
        ):
            self.send_json(400, {"error": "Invalid message or conversation history."})
            return

        try:
            answer = get_bot_response(user_message.strip(), conversation)
        except Exception as error:
            print(f"Gemini request failed ({type(error).__name__}).")
            self.send_json(
                502,
                {"error": "Gemini could not respond. Check the server terminal and try again."},
            )
            return

        self.send_json(200, {"answer": answer or ""})

    def send_json(self, status, payload):
        body = json.dumps(payload).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("X-Content-Type-Options", "nosniff")
        self.end_headers()
        self.wfile.write(body)


def run_web():
    server = ThreadingHTTPServer(("127.0.0.1", 8000), WebRequestHandler)
    print("Website running at http://127.0.0.1:8000")
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\nWebsite server stopped.")
    finally:
        server.server_close()


if __name__ == "__main__":
    if "--web" in sys.argv[1:]:
        run_web()
    elif "--gui" in sys.argv[1:]:
        run_gui()
    else:
        run_cli()